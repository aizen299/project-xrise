# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored; this file is committed.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (free M0 tier).
# Atlas -> Cluster -> Connect -> Drivers -> copy the Node.js string, then
# append the database name.
#
# Percent-encode the password if it contains @ : / ? # [ ] % or $
# The $ matters: Next.js expands $VAR in .env values, so an unescaped $ in a
# password is silently mangled and Atlas rejects the login. Encode it as %24.
#
# If your network's DNS mangles SRV lookups (querySrv EBADRESP), use Atlas's
# standard connection string instead — it lists the shard hosts directly and
# performs no SRV lookup. See the README troubleshooting section.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/xrise-helpdesk?retryWrites=true&w=majority

# Secret used to sign agent JWTs. Minimum 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Canonical origin of the deployed app. Used for absolute URLs and cookie scope.
APP_ORIGIN=http://localhost:3000

# development | test | production
NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Passwords assigned to the seeded agent accounts (local development only).
SEED_AGENT_PASSWORD=Password123!
SEED_ADMIN_PASSWORD=Password123!

# ---------------------------------------------------------------------------
# AI API Provider
# ---------------------------------------------------------------------------
# groq | gemini | openrouter | ollama
LLM_PROVIDER=groq
LLM_API_KEY=
